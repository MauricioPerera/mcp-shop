# Local dev only. In production these are read from files instead
# (AUTH_TOKEN_FILE, ADMIN_AUTH_TOKEN_FILE, WEBHOOK_SECRET_FILE — see
# ecosystem.config.cjs and README.md), so tokens never sit in `ps`/pm2 env
# dumps in plaintext.

PORT=8796
DB_PATH=./data/shop.db

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_TOKEN=
ADMIN_AUTH_TOKEN=
WEBHOOK_SECRET=

# Optional — only needed if testing checkout links from another host.
PUBLIC_HOST=
